\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Live-simulator latency is bounded by simulator synchronization, not by the classifier -- the opposite bottleneck from trace replay.} Per-stage mean latency, SUMO replay (Table~\ref {tab:complexity}) vs.\ live CARLA (this pass's fresh final-checkpoint rerun), both real. SUMO's dominant cost is B3's forward pass; CARLA's is \texttt  {bridge\_ms} (world-tick/actor-state synchronization) -- not B3, since no such synchronization cost exists in a replayed trace.}}{10}{}\protected@file@percent }
\newlabel{fig_stage_latency_compare}{{6}{10}{}{figure.6}{}}
